# CloudNerd / DietNerd Agent Backend — local overrides (optional)
# Domain pack: CloudNerd (Stack Overflow cascade) | DietNerd (PubMed legacy)

PORT=8001
AGENT_MODEL=gpt-4-turbo
AGENT_MAX_STEPS=12
AGENT_MAX_SEARCH_ATTEMPTS=2
AGENT_RUN_RETRIES=2

# Domain: CloudNerd | DietNerd (copies saved_states/<name> into customnerd-backend)
AGENT_DOMAIN=DietNerd

# hybrid (recommended) | parity | adaptive
AGENT_MODE=hybrid
USE_LANGGRAPH=false
HYBRID_RESCUE_ENABLED=true
# Soft hybrid rescue helps relevancy; zero-only was too aggressive for Rel
AGENT_HYBRID_RESCUE_ON_ZERO_ONLY=false
FAITHFULNESS_VERIFY_ENABLED=true

# Faith-first policy (balanced for RAGAS faithfulness AND relevancy)
AGENT_FAITH_FIRST=true
AGENT_POST_FILTER_MODE=rank_only
AGENT_FAITH_OVERLAP_THRESHOLD=0.40
AGENT_FACTS_ONLY_HIGH_OVERLAP=0.80
# Prefer grounded combined synthesis over facts-only (removes noncommittal gap-talk)
AGENT_PREFER_COMBINED_SYNTHESIS=true
# Query-focused summary of the final relevant articles (aligns RAGAS contexts)
AGENT_ORGANIZE_RELEVANT=true
AGENT_LOW_DOMAIN_OVERLAP_RESEARCH=0.15
AGENT_LOW_OVERLAP_TOP_K=2
AGENT_LOW_OVERLAP_TOP_K_EXTENDED=5
AGENT_MIN_EVIDENCE_OVERLAP_SHIP=0.12

# DietNerd: true (fast Entrez map). CloudNerd: true (fast SO map).
AGENT_FAST_ORGANIZE=true
AGENT_SKIP_URL_REENRICH=true
AGENT_ORGANIZE_MAX_ARTICLES=20
AGENT_RELEVANCE_PREFILTER_TOP_K=10

# Relevance / faithfulness tuning
AGENT_MIN_RELEVANT=2
AGENT_ADAPTIVE_TOP_K=5
AGENT_DOMAIN_OVERLAP_MIN=0.25
AGENT_RESCUE_TOP_K=3

# DietNerd forces legacy; CloudNerd typically uses cascade
RETRIEVAL_MODE=legacy
CITATION_RESCUE_ENABLED=true
RETRIEVAL_GAP_FILL_ENABLED=true
FAITHFULNESS_TWO_PASS_ENABLED=true

# LANGCHAIN_PROJECT=customnerd-setB-agent-hybrid
